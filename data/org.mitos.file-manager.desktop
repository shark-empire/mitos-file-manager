[Desktop Entry]
Type=Application
Version=1.0
Name=Files
GenericName=File Manager
Comment=Browse and manage files and folders
Exec=mitos-file-manager %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
Keywords=files;folders;browse;explorer;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=mitos-file-manager
